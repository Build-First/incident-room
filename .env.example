# Copy this file to .env.local and put your real values in it.
#
#   cp .env.example .env.local
#
# .env.local is in .gitignore. This file is not, and must never hold a real key.

# Claude, for reading articles and writing the report.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-replace-me

# Supabase, for remembering any of it.
# Both are in your project under Settings, API.
# Take the SERVICE ROLE key, not the anon key, and treat it like the one above:
# it belongs here and in Vercel, never in a file you commit.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me
